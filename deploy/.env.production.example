# ─────────────────────────────────────────────────────────────────────────────
# DocPipe — production .env example
# ─────────────────────────────────────────────────────────────────────────────
# Copy to deploy/.env (same directory as docker-compose.prod.yml) and edit.
# Never commit deploy/.env.
#
# Required to edit before first deploy:
#   - DOMAIN
#   - DOCPIPE_API_KEYS  (or leave empty to let DocPipe auto-generate)
#   - DOCPIPE_CORS_ORIGINS  (the exact origins of your callers)
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ────────────────────────────────────────────────────────────────

# Public hostname Traefik routes to this service.
DOMAIN=docpipe.example.com

# ── Image & service ─────────────────────────────────────────────────────────

# Pin to a version tag (e.g. v2.0.1) in production. `latest` follows main.
DOCPIPE_VERSION=latest
SERVICE_NAME=docpipe
DATA_VOLUME_NAME=docpipe-data

# ── Traefik wiring ──────────────────────────────────────────────────────────

# External docker network shared with Traefik (create with: docker network create traefik)
TRAEFIK_NETWORK=traefik

# Traefik entrypoint names. Defaults assume `web` on :80 and `websecure` on :443.
TRAEFIK_ENTRYPOINT_INSECURE=web
TRAEFIK_ENTRYPOINT_SECURE=websecure

# Cert resolver name (configured in Traefik's static config).
TRAEFIK_CERT_RESOLVER=letsencrypt

# ── API keys ────────────────────────────────────────────────────────────────

# Comma-separated name:secret pairs. Generate with:
#   ./scripts/gen-apikey.sh portal internal
#
# If LEFT EMPTY, DocPipe auto-generates 10 keys on first start and persists
# them to the docpipe-data volume. Retrieve them with:
#   docker exec docpipe cat /app/data/api-keys.json
#
# Set this explicitly for multi-host or auto-scaled deployments where every
# instance must honour the same key set regardless of which volume it touches.
DOCPIPE_API_KEYS=

# ── CORS ────────────────────────────────────────────────────────────────────

# Exact-match origin allow-list. Comma-separated. No wildcards.
DOCPIPE_CORS_ORIGINS=https://apply.casckjobs.org,https://www.apply.casckjobs.org,https://casck-jobportal.vercel.app

# ── Runtime ─────────────────────────────────────────────────────────────────

DOCPIPE_ENV=production
DOCPIPE_LOG_LEVEL=info
DOCPIPE_LOG_FORMAT=json

# ── Request guardrails ──────────────────────────────────────────────────────

DOCPIPE_MAX_BODY_BYTES=10485760
DOCPIPE_RENDER_TIMEOUT=30s
DOCPIPE_RENDER_CONCURRENCY=4
DOCPIPE_RATE_LIMIT_RPS=5
DOCPIPE_RATE_LIMIT_BURST=10

# ── Renderer ────────────────────────────────────────────────────────────────

DOCPIPE_BROWSER_RECYCLE_AFTER=500
DOCPIPE_BROWSER_HEALTHCHECK_INTERVAL=30s

# ── Analytics ───────────────────────────────────────────────────────────────

DOCPIPE_SNAPSHOT_INTERVAL=1h
DOCPIPE_DAILY_RETENTION_DAYS=30
DOCPIPE_STATS_PUBLIC=true

# ── Swagger ─────────────────────────────────────────────────────────────────

# Usually off in production. Flip to `true` for short debugging windows.
DOCPIPE_ENABLE_SWAGGER=false

# Additional servers shown in the Swagger UI "Servers" dropdown. PREPENDED
# to the two defaults baked into the spec (https://docpipe.services.monzim.com
# and http://localhost:8080), so env entries appear first in the dropdown.
#
# Format: comma-separated, each entry is `URL` or `URL|Description`.
# Examples:
#   DOCPIPE_SWAGGER_SERVERS=https://staging.docpipe.example.com|Staging
#   DOCPIPE_SWAGGER_SERVERS=https://prod.example.com|Production,https://staging.example.com|Staging
#   DOCPIPE_SWAGGER_SERVERS=https://prod.example.com    (URL only — no description)
#
# Leave empty to use just the YAML defaults.
DOCPIPE_SWAGGER_SERVERS=

# ── Container resource ceilings ─────────────────────────────────────────────

# These limits are enforced by docker compose v2 outside of Swarm. Sized for a
# small VPS (2 vCPU / 2 GB). Increase if you run heavy concurrent renders.
DOCPIPE_CPU_LIMIT=2
DOCPIPE_MEM_LIMIT=2g
DOCPIPE_CPU_RESERVATION=0.25
DOCPIPE_MEM_RESERVATION=256m
