# Copy to .env and edit. Never commit .env.
#
# Generate strong keys with: ./scripts/gen-apikey.sh
#
# All settings here are read at process start; restart docpipe after changes.

# --- API keys (optional) ---
# Comma-separated name:secret pairs. The name labels logs/metrics; the secret
# is what callers send in Authorization or X-API-Key.
#
# If left UNSET, DocPipe auto-generates 10 keys on first startup and persists
# them to ${DOCPIPE_DATA_DIR}/api-keys.json — the same keys come back on
# every restart. Retrieve them with:
#
#   docker exec docpipe cat /app/data/api-keys.json
#   docker logs docpipe 2>&1 | grep -A 14 'auto-generated API keys'
#
# Set this if you want explicit, env-driven keys that don't depend on volume
# state (recommended for multi-host or auto-scaled deployments).
# DOCPIPE_API_KEYS=portal:ak_live_REPLACE_ME_32_HEX,internal:ak_live_REPLACE_ME_32_HEX

# --- HTTP listener ---
DOCPIPE_PORT=8080
DOCPIPE_HOST=0.0.0.0
DOCPIPE_ENV=production                  # set to "development" for verbose logs + swagger
DOCPIPE_LOG_LEVEL=info                  # debug | info | warn | error
DOCPIPE_LOG_FORMAT=json                 # json | console

# --- CORS ---
# Exact-origin match, comma-separated. Production allow-list for CASCK below.
DOCPIPE_CORS_ORIGINS=https://apply.casckjobs.org,https://www.apply.casckjobs.org,https://casck-jobportal.vercel.app

# --- Request guardrails ---
DOCPIPE_MAX_BODY_BYTES=10485760         # 10 MiB
DOCPIPE_RENDER_TIMEOUT=30s
DOCPIPE_RENDER_CONCURRENCY=             # default: runtime.NumCPU()
DOCPIPE_RATE_LIMIT_RPS=5
DOCPIPE_RATE_LIMIT_BURST=10

# --- Renderer ---
DOCPIPE_CHROME_PATH=/usr/bin/chromium-browser
DOCPIPE_BROWSER_RECYCLE_AFTER=500
DOCPIPE_BROWSER_HEALTHCHECK_INTERVAL=30s

# --- Analytics ---
DOCPIPE_DATA_DIR=./data
DOCPIPE_SNAPSHOT_INTERVAL=1h
DOCPIPE_DAILY_RETENTION_DAYS=30

# --- Public surface ---
DOCPIPE_STATS_PUBLIC=true               # set false to require auth on /v1/stats
DOCPIPE_ENABLE_SWAGGER=false            # auto-true if DOCPIPE_ENV=development
